<UserControl x:Class="PcImpressz.Shell.Windows.OrdersPageView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="MinHeight" Value="34"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5,7"/></Style>
 </UserControl.Resources>
 <StackPanel>
  <TextBlock Text="Vevői rendelések" Style="{StaticResource SectionTitle}"/>
  <TextBlock Text="Rendelés → szabad készlet foglalása → részátadás. Az átadás helyi eladási bizonylatot készít; a számlaigény még nem számlakiállítás." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
  <Border Style="{StaticResource Card}"><StackPanel>
   <WrapPanel IsEnabled="{Binding IsUsable}">
    <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Width="240" ToolTip="Keresés rendelésszám, vevő és megjegyzés alapján" Margin="0,0,8,8"/>
    <ComboBox SelectedValue="{Binding StatusFilter}" SelectedValuePath="Tag" DisplayMemberPath="Content" Width="160" Margin="0,0,8,8">
     <ComboBoxItem Content="Nyitott rendelések" Tag="open"/><ComboBoxItem Content="Minden rendelés" Tag="all"/><ComboBoxItem Content="Lefoglalva" Tag="reserved"/><ComboBoxItem Content="Részben átadva" Tag="partial"/><ComboBoxItem Content="Átadva" Tag="completed"/><ComboBoxItem Content="Lemondva" Tag="cancelled"/>
    </ComboBox>
    <Button Content="Keresés / frissítés" Command="{Binding RefreshCommand}" Margin="0,0,8,8"/>
    <Button Content="Új rendelés" Command="{Binding NewCommand}" IsEnabled="{Binding CanWrite}" Margin="0,0,0,8"/>
   </WrapPanel>
   <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedOrder,Mode=TwoWay}" IsEnabled="{Binding IsUsable}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="215" HeadersVisibility="Column" ScrollViewer.HorizontalScrollBarVisibility="Auto">
    <DataGrid.Columns><DataGridTextColumn Header="Rendelés" Binding="{Binding Number}" Width="155"/><DataGridTextColumn Header="Vevő" Binding="{Binding Customer}" Width="260"/><DataGridTextColumn Header="Határidő" Binding="{Binding Due}" Width="110"/><DataGridTextColumn Header="Állapot" Binding="{Binding Status}" Width="130"/><DataGridTextColumn Header="Bruttó (Ft)" Binding="{Binding Gross,StringFormat=N2}" Width="120"/></DataGrid.Columns>
   </DataGrid>
   <WrapPanel Margin="0,10,0,0" IsEnabled="{Binding IsUsable}"><Button Content="Előző" Command="{Binding PreviousCommand}"/><TextBlock Text="{Binding PageLabel}" Margin="12,6"/><Button Content="Következő" Command="{Binding NextCommand}"/></WrapPanel>
  </StackPanel></Border>
  <TextBlock Text="{Binding Header}" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
  <Border Style="{StaticResource Card}"><StackPanel>
   <Grid IsEnabled="{Binding CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="Vevő (a partnertörzsből)"/><ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedCustomer,Mode=TwoWay}" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Raktár"/><TextBox Text="{Binding Warehouse,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Határidő · ÉÉÉÉ-HH-NN"/><TextBox Text="{Binding DueDate,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel>
   </Grid>
   <TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" ToolTip="Megjegyzés a rendeléshez" Margin="0,10,0,10"/>
   <WrapPanel IsEnabled="{Binding IsUsable}"><TextBox Text="{Binding ProductSearch,UpdateSourceTrigger=PropertyChanged}" Width="230" ToolTip="Termékkeresés név, cikkszám vagy vonalkód alapján" Margin="0,0,8,8"/><TextBox Text="{Binding CustomerSearch,UpdateSourceTrigger=PropertyChanged}" Width="200" ToolTip="Vevőkeresés név vagy adószám alapján" Margin="0,0,8,8"/><Button Content="Termékek / vevők keresése" Command="{Binding ReferencesCommand}" Margin="0,0,0,8"/></WrapPanel>
   <Grid Margin="0,0,0,10" IsEnabled="{Binding CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Products}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedProduct}"/><Button Grid.Column="1" Content="Tétel hozzáadása" Command="{Binding AddLineCommand}" Margin="8,0"/><Button Grid.Column="2" Content="Kijelölt törlése" Command="{Binding RemoveLineCommand}"/></Grid>
   <DataGrid x:Name="LinesGrid" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" IsEnabled="{Binding IsUsable}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" Height="270" HeadersVisibility="Column" ScrollViewer.HorizontalScrollBarVisibility="Auto">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Termék" Binding="{Binding Name}" Width="250" IsReadOnly="True"/>
     <DataGridTextColumn Header="Rendelt" Binding="{Binding QuantityText,UpdateSourceTrigger=PropertyChanged}" Width="80"/>
     <DataGridTextColumn Header="Nettó egységár" Binding="{Binding PriceText,UpdateSourceTrigger=PropertyChanged}" Width="110"/>
     <DataGridTextColumn Header="Áfa %" Binding="{Binding VatText,UpdateSourceTrigger=PropertyChanged}" Width="65"/>
     <DataGridTextColumn Header="Foglalt" Binding="{Binding Reserved}" Width="75" IsReadOnly="True"/>
     <DataGridTextColumn Header="Átadott" Binding="{Binding Delivered}" Width="75" IsReadOnly="True"/>
     <DataGridTextColumn Header="Hiányzik" Binding="{Binding Missing}" Width="75" IsReadOnly="True"/>
     <DataGridTextColumn Header="Most átad" Binding="{Binding DeliveryText,UpdateSourceTrigger=PropertyChanged}" Width="85"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="{Binding Summary}" Margin="0,12,0,8" TextWrapping="Wrap"/>
   <WrapPanel>
    <Button Content="Rendelés mentése" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/>
    <TextBox Text="{Binding ReservationDays}" Width="55" ToolTip="Foglalás napokban (1–365)" Margin="0,0,5,10" IsEnabled="{Binding CanAct}"/>
    <Button Content="napra foglalás / hosszabbítás" Command="{Binding ReserveCommand}" IsEnabled="{Binding CanAct}" Margin="0,0,10,10"/>
    <Button Content="Foglalás feloldása" Command="{Binding ReleaseCommand}" IsEnabled="{Binding CanAct}" Margin="0,0,10,10"/>
    <Button Content="Rendelés lemondása" Command="{Binding CancelCommand}" IsEnabled="{Binding CanAct}" Margin="0,0,0,10"/>
   </WrapPanel>
   <WrapPanel><CheckBox Content="Kártyás fizetés (különben készpénz)" IsChecked="{Binding CardPayment}" IsEnabled="{Binding CanDeliver}" Margin="0,8,16,8"/><CheckBox Content="Számlaigény" IsChecked="{Binding InvoiceRequested}" IsEnabled="{Binding CanDeliver}" Margin="0,8,16,8"/><Button Content="Megadott mennyiség átadása" Command="{Binding DeliverCommand}" IsEnabled="{Binding CanDeliver}"/></WrapPanel>
   <TextBlock Text="{Binding DeliveryHistory}" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,14,0,10"/>
  <Button Content="Bizonytalan művelet újraellenőrzése" Command="{Binding RetryCommand}" IsEnabled="{Binding CanRetry}" HorizontalAlignment="Left"/>
 </StackPanel>
</UserControl>
