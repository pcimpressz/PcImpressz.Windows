<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PcImpressz.Shell.Windows">
  <DataTemplate DataType="{x:Type local:OperationsPageViewModel}">
    <local:OperationsPageView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:ProductWorkspaceViewModel}">
    <StackPanel>
      <WrapPanel>
        <Button Content="Feliratok és elrendezés – admin" Command="{Binding Products.EditLayoutCommand}" IsEnabled="{Binding Products.CanAdmin}" Margin="0,0,10,10" />
        <Button Content="Új termék" Command="{Binding NewProductCommand}" IsEnabled="{Binding Products.CanWrite}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10" />
        <Button Content="Kijelölt termék szerkesztése" Command="{Binding EditProductCommand}" IsEnabled="{Binding Products.CanWrite}" Margin="0,0,10,10" />
        <Button Content="Kijelölt termék készlete és mozgásai" Command="{Binding SelectedStockCommand}" Margin="0,0,10,10" />
        <Button Content="Minden termék készlete" Command="{Binding AllStockCommand}" Margin="0,0,0,10" />
      </WrapPanel>
      <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" Padding="14">
        <TabControl.Resources>
          <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                  <Border x:Name="Header" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8,8,0,0" Padding="18,10" Margin="0,0,6,0">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Header" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                      <Setter TargetName="Header" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                      <Setter TargetName="Header" Property="BorderThickness" Value="2" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </TabControl.Resources>
        <TabItem Header="Terméklista">
          <local:EntityPageView DataContext="{Binding Products}" ViewMode="list" />
        </TabItem>
        <TabItem Header="Termékadatlap">
          <local:EntityPageView DataContext="{Binding Products}" ViewMode="editor" />
        </TabItem>
        <TabItem Header="Készlet és mozgások">
          <ContentControl Content="{Binding Inventory}" />
        </TabItem>
      </TabControl>
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:EntityPageViewModel}">
    <local:EntityPageView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:ReceivingPageViewModel}">
    <local:ReceivingPageView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:DashboardPage}">
    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
      <Border Style="{StaticResource Card}" Padding="32" Margin="0,0,0,22">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
          </Grid.ColumnDefinitions>
          <StackPanel MaxWidth="650" HorizontalAlignment="Left">
            <TextBlock Text="EGY BIZTOS ALAP. A SAJÁT RENDSZERED." Style="{StaticResource Eyebrow}" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="A munkaterületed,&#xA;a saját ritmusodra." FontSize="{DynamicResource DisplaySize}" FontWeight="SemiBold" Margin="0,17,0,15" />
            <TextBlock Text="Egy átlátható keret, különálló modulokkal. Alakítsd a felületet magadhoz, és bővítsd a rendszert, amikor szükséged van rá." Style="{StaticResource Muted}" />
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
              <Button Content="Megjelenés testreszabása" Style="{StaticResource PrimaryButton}" Command="{Binding GoAppearanceCommand}" Margin="0,0,12,0" />
              <Button Content="Modulok" Command="{Binding GoModulesCommand}" />
            </StackPanel>
          </StackPanel>
          <Grid Grid.Column="1" Width="152" Height="180" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border Width="90" Height="90" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}" Background="{DynamicResource ElevatedBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Border Width="110" Height="110" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="P" Foreground="{DynamicResource AccentBrush}" FontSize="54" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentTextBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Grid>
      </Border>
      <Grid Margin="0,0,0,28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,14,0">
          <StackPanel>
            <TextBlock Text="RENDSZER" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding HostLabel}" FontSize="{DynamicResource SubtitleSize}" FontWeight="SemiBold" Margin="0,14,0,8" />
            <TextBlock Text="{Binding HostDetail}" Style="{StaticResource Muted}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,0">
          <StackPanel>
            <TextBlock Text="AKTÍV MODULOK" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding ActiveModuleCount}" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" Margin="0,8,0,5" />
            <TextBlock Text="{Binding ModuleSummary}" Style="{StaticResource Muted}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="LICENC" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding LicenseLabel}" FontSize="{DynamicResource SubtitleSize}" FontWeight="SemiBold" Margin="0,14,0,8" />
            <Button Content="Részletek megnyitása  →" Command="{Binding GoLicenseCommand}" Style="{StaticResource GhostButton}" Padding="0,3" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </Grid>
      <TextBlock Text="Tedd otthonossá a munkafelületed" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Három alaphangulat. Számtalan lehetőség." FontWeight="SemiBold" />
            <TextBlock Text="Éjkék, Porcelán vagy Grafit — saját kiemelőszínnel, betűmérettel és elrendezéssel." Style="{StaticResource Muted}" Margin="0,8,18,0" />
          </StackPanel>
          <Button Grid.Column="1" Content="Saját stílus beállítása" Command="{Binding GoAppearanceCommand}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:ModulesPage}">
    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
      <Border Style="{StaticResource Card}" Visibility="{Binding HasNoModules, Converter={StaticResource BoolVisibility}}" Padding="44">
        <StackPanel HorizontalAlignment="Center" MaxWidth="560">
          <Border Width="74" Height="74" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,22">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Hely az első modulodnak." FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" TextAlignment="Center" />
          <TextBlock Text="Még nincs telepített modul. A terméktörzs, készletkezelés és további funkciók külön bővítményként csatlakoznak ehhez a kerethez." Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,14,0,24" />
          <Button Content="Modulmappa megnyitása" Command="{Binding OpenModulesCommand}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding Modules}" Visibility="{Binding HasModules, Converter={StaticResource BoolVisibility}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Id}" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" />
                  <TextBlock Text="{Binding UsageLabel}" Margin="0,12,0,8" FontWeight="SemiBold" />
                  <CheckBox Content="Használatban" IsChecked="{Binding Enabled}" IsEnabled="{Binding DataContext.IsCompanyAdmin, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding ToggleName}" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                  <TextBlock Text="{Binding State}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Version}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="A technikai betöltés és a használati jogosultság külön állapot. A fizetős műveleteket a mag minden alkalommal ellenőrzi." Style="{StaticResource Muted}" Margin="4,20,4,0" />
      <TextBlock Text="A kikapcsolt modul eltűnik a munkaterület menüjéből, és a parancsai nem futtathatók. A választás a következő indításkor is megmarad. Az áttekintés, a beállítások, a licenc és a megjelenés a keret része, mindig elérhető." Style="{StaticResource Muted}" Margin="4,10,4,0" />
      <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource Muted}" Margin="4,14,4,0" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:LicensePage}">
    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="HASZNÁLATI JOGOSULTSÁG" Style="{StaticResource Eyebrow}" />
          <TextBlock Text="{Binding LicenseLabel}" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" Margin="0,18,0,12" />
          <TextBlock Text="{Binding LicenseReason}" Style="{StaticResource Muted}" />
          <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,25" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="MŰKÖDÉSI ENGEDÉLY HATÁRIDEJE" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="{Binding LicenseUntil}" Margin="0,10,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="TELEPÍTÉSAZONOSÍTÓ" Style="{StaticResource Eyebrow}" />
              <TextBox Text="{Binding InstallationId, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,20,0,0">
        <StackPanel>
          <TextBlock Text="Az adataid megmaradnak." Style="{StaticResource SectionTitle}" />
          <TextBlock Text="Lejárt modul-előfizetés esetén a fizetős írási műveletek leállnak. Az adatok megtekintéséhez és alapvető exportálásához továbbra is a felhasználói jogosultságod szükséges." Style="{StaticResource Muted}" />
          <TextBlock Text="Az online aktiválás és megújítás ebben a fejlesztői változatban még nem elérhető." Style="{StaticResource Muted}" Margin="0,14,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:AppearancePage}">
    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
      <TextBlock Text="Válassz egy alaphangulatot" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="A váltás azonnal látszik. A beállításaid a következő indításkor is megmaradnak." Style="{StaticResource Muted}" Margin="0,0,0,20" />
      <ListBox ItemsSource="{Binding Skins}" SelectedItem="{Binding SelectedSkin}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,0,-14,24" AutomationProperties.Name="Felületi téma">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Frame" BorderThickness="2" BorderBrush="{DynamicResource StrokeBrush}" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" Padding="5">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="210">
              <Border Background="{Binding Palette.Background}" CornerRadius="9" Height="116" Padding="10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="43" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Background="{Binding Palette.Sidebar}" CornerRadius="5" Margin="0,0,8,0">
                    <StackPanel Margin="6,9">
                      <Border Height="12" Width="12" Background="{Binding Palette.Accent}" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,12" />
                      <Border Height="5" Background="{Binding Palette.Accent}" CornerRadius="2" Margin="0,0,0,7" />
                      <Border Height="5" Background="{Binding Palette.Stroke}" CornerRadius="2" Margin="0,0,0,7" />
                      <Border Height="5" Background="{Binding Palette.Stroke}" CornerRadius="2" />
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="1">
                    <Border Height="7" Width="76" Background="{Binding Palette.Text}" CornerRadius="2" HorizontalAlignment="Left" Margin="2,4,0,12" />
                    <Border Height="35" Background="{Binding Palette.Surface}" CornerRadius="5" Margin="0,0,0,8" />
                    <UniformGrid Columns="2">
                      <Border Height="23" Background="{Binding Palette.Surface}" CornerRadius="4" Margin="0,0,5,0" />
                      <Border Height="23" Background="{Binding Palette.Surface}" CornerRadius="4" />
                    </UniformGrid>
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="10,14,10,12" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,18,20">
          <StackPanel>
            <TextBlock Text="Kiemelőszín" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Egy apró részlet, amitől a tiéd lesz." Style="{StaticResource Muted}" Margin="0,0,0,16" />
            <ListBox ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Kiemelőszín">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Cursor" Value="Hand" />
                  <Setter Property="ToolTip" Value="{Binding Name}" />
                  <Setter Property="Margin" Value="0,0,8,8" />
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Ring" Padding="4" CornerRadius="22" BorderThickness="2" BorderBrush="Transparent">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                          </Trigger>
                          <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Ellipse Width="30" Height="30" Fill="{Binding Color}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,20">
          <StackPanel>
            <TextBlock Text="Betűméret" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Kényelmes olvasás a saját kijelződön." Style="{StaticResource Muted}" Margin="0,0,0,16" />
            <ComboBox ItemsSource="{Binding FontSizes}" SelectedItem="{Binding SelectedFontSize}" DisplayMemberPath="Name" AutomationProperties.Name="Betűméret" />
          </StackPanel>
        </Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20">
        <StackPanel>
          <TextBlock Text="Elrendezés" Style="{StaticResource SectionTitle}" />
          <CheckBox Content="Összecsukott oldalsáv" IsChecked="{Binding CollapsedNavigation}" Margin="0,10,0,18" />
          <CheckBox Content="Kompakt térközök" IsChecked="{Binding CompactDensity}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,20,0">
            <TextBlock Text="Saját skinek" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Mentsd ki a jelenlegi színpalettát, szerkeszd a színeket, majd importáld saját témaként." Style="{StaticResource Muted}" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <Button Content="Skin importálása" Command="{Binding ImportSkinCommand}" Margin="0,0,0,8" />
            <Button Content="Jelenlegi skin exportálása" Command="{Binding ExportSkinCommand}" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Notice}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,20,0" />
        <Button Grid.Column="1" Content="Alaphelyzet" Command="{Binding ResetAppearanceCommand}" Style="{StaticResource GhostButton}" />
      </Grid>
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:SettingsPage}">
    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
      <Expander Header="Általános és listák" IsExpanded="True" Margin="0,0,0,18">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Helyi munkaterület" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Az alkalmazás saját beállításai, naplói és moduljai ebben a mappában találhatók." Style="{StaticResource Muted}" />
              <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" Background="{DynamicResource ElevatedBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="14" Margin="0,18,0,18" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal">
                <Button Content="Adatmappa megnyitása" Command="{Binding OpenDataCommand}" Margin="0,0,12,0" />
                <Button Content="Naplók megnyitása" Command="{Binding OpenLogsCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
              <TextBlock Text="Listák" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Minden törzs- és listaoldalon a kereső névrészletre szűkít, a találatok darabszáma mellette látszik. A fejléc kattintása rendezi az egész listát. Az oszlopokat itt, vagy az oldalon a kis fogaskerékkel kapcsolhatod. A terméktörzs Darabszám oszlopa az összes raktár készletét mutatja. Raktárankénti bontás a Készlet oldalon." Style="{StaticResource Muted}" />
              <ComboBox ItemsSource="{Binding ListPages}" SelectedItem="{Binding SelectedListPage}" DisplayMemberPath="Title" Margin="0,16,0,12" MinHeight="36" />
              <ItemsControl ItemsSource="{Binding ColumnChoices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Visible, Mode=TwoWay}" Margin="0,4" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding ListSortLabel}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
              <TextBlock Text="{Binding ListNotice}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
              <Button Content="Oszlopok alaphelyzete" Command="{Binding ResetListLayoutCommand}" Margin="0,14,0,0" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
              <TextBlock Text="Kapcsolat és állapot" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding DiagnosticDetail}" Style="{StaticResource Muted}" />
              <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="MAG SZERZŐDÉSVÁLTOZATA" Style="{StaticResource Eyebrow}" />
                  <TextBlock Text="{Binding ContractVersion}" Margin="0,9,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="UTOLSÓ ÁLLAPOTFRISSÍTÉS" Style="{StaticResource Eyebrow}" />
                  <TextBlock Text="{Binding LastUpdated}" Margin="0,9,0,0" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Expander>
      <Expander Header="Partnertörzs" IsExpanded="True" Margin="0,0,0,18">
        <StackPanel>
          <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Név formázás" Style="{StaticResource SectionTitle}" />
              <CheckBox Content="NAV-ból érkező nagybetűs nevek és címek formázása" IsChecked="{Binding FormatPartnerNames, Mode=TwoWay}" Margin="0,12,0,8" />
              <TextBlock Text="Az új partner NAV-adatlapján a csupa nagybetűs cégnév és cím kezdőbetűsre alakul. A vegyes írásmódot és néhány ismert rövidítést megőrzi. A meglévő partnereket nem írja át." Style="{StaticResource Muted}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Expander>
      <Expander Header="Eladás és készlet" IsExpanded="True" Margin="0,0,0,18">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
              <TextBlock Text="Pénzösszegek megjelenítése" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Tizedesjegyek száma (alapérték: 0). Csak a megjelenítést módosítja; a számítás és a mentett ár pontos marad. Készpénzes végösszeg: 5 Ft-os kerekítés." Style="{StaticResource Muted}" />
              <ComboBox ItemsSource="{Binding MoneyDecimalChoices}" SelectedItem="{Binding MoneyDecimals, Mode=TwoWay}" Width="130" HorizontalAlignment="Left" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Expander>
      <Expander Header="NAV-kapcsolat" IsExpanded="True" Margin="0,0,0,18">
        <StackPanel>
          <local:NavConnectionCard Margin="0,20,0,0" IsEnabled="{Binding IsCompanyAdmin}" />
        </StackPanel>
      </Expander>
      <Expander Header="Cégadatok és mentések" IsExpanded="True" Margin="0,0,0,18">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
              <TextBlock Text="Cégmentés és visszaállítás" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Az aktuális cég ellenőrzött mentése és visszaállítása új cégként. A meglévő cégek adatai megmaradnak." Style="{StaticResource Muted}" />
              <WrapPanel Margin="0,16,0,0" IsEnabled="{Binding WorkspaceIsIdle}">
                <Button Content="Kiválasztott cég mentése" Command="{Binding BackupCompanyCommand}" IsEnabled="{Binding IsCompanyAdmin}" Margin="0,0,12,8" />
                <Button Content="Visszaállítás új cégként" Command="{Binding RestoreCompanyCommand}" IsEnabled="{Binding IsCompanyAdmin}" Margin="0,0,0,8" />
              </WrapPanel>
              <TextBlock Text="{Binding BackupMessage}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
              <TextBlock Text="Demócég és mintaadatok" Style="{StaticResource SectionTitle}" />
              <local:DemoDataCard />
              <TextBlock Text="A demó cég a kísérleti adatbázis. A törlés a cég moduladatait távolítja el: partnereket, terméktörzset, a mentett NAV-kapcsolatot és minden mást a cég mappájából. A cég bejegyzése megmarad, utána a meglévő képernyőkön üresen lehet új adatot felvinni. A licenc, a megjelenés és a modulok ki-be állapota a helyén marad. Más cég adata nem törlődik." Style="{StaticResource Muted}" />
              <Button Content="Demó cég adatainak törlése" Command="{Binding ClearDemoDataCommand}" IsEnabled="{Binding CanSeedDemo}" Margin="0,18,0,0" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource Muted}" Margin="0,14,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Expander>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>