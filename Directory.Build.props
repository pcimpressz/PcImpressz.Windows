<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);**/obj/**;**/bin/**;obj/Debug/**;obj/Release/**;obj/codex-build/**;artifacts/**/*.AssemblyInfo.cs;artifacts/**/*AssemblyAttributes.cs;artifacts/**/*.GlobalUsings.g.cs</DefaultItemExcludesInProjectFolder>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**;obj/Debug/**;obj/Release/**;obj/codex-build/**;artifacts/**/*.AssemblyInfo.cs;artifacts/**/*AssemblyAttributes.cs;artifacts/**/*.GlobalUsings.g.cs</DefaultItemExcludes>
    <Version>0.4.22</Version>
  </PropertyGroup>
  <!-- A dev.ps1 és a normál fordítás ugyanebből a szabályból kapja a köztes könyvtárat. -->
  <PropertyGroup Condition="'$(PcImpresszIntermediate)' == 'codex'">
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)\obj\codex\</MSBuildProjectExtensionsPath>
    <IntermediateOutputPath>obj\codex-build\</IntermediateOutputPath>
  </PropertyGroup>
</Project>
